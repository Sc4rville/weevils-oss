#!/bin/bash
# sw_vers of the fake Mac.
case "${1:-}" in
  '') printf 'ProductName:\t\tmacOS\nProductVersion:\t\t15.5\nBuildVersion:\t\t24F74\n' ;;
  -productName | --productName) echo macOS ;;
  -productVersion | --productVersion) echo 15.5 ;;
  -buildVersion | --buildVersion) echo 24F74 ;;
  *) echo "Usage: sw_vers [--help|--productName|--productVersion|--productVersionExtra|--buildVersion]" >&2; exit 1 ;;
esac
