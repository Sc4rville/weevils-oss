weevils page list <items.json> "title" [--kind opportunities] · weevils page library "title" <folder>…
weevils pages · weevils page machine · weevils page rm <slug>'
  export WVM_NO_ASKS='(no requests)' WVM_STALE='STALE' WVM_PENDING='message(s) not split into requests yet' WVM_REPORT='report' WVM_EXPECT='expects'
