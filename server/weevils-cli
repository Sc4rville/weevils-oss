#!/usr/bin/env bash
# weevils — la commande de l'orchestrateur (et de n'importe quel agent sur cette machine) pour parler aux sessions.
# Elle appelle le weevilsd local avec le jeton de la machine (~/.local/share/weevils/local-token, en-tête
# X-Weevils-Local) : pas de code à fournir. Dans la prison d'une automatisation, ce fichier est caché : weevilsd la
# reconnaît à son espace de processus et ne lui ouvre que ses routes (server/jail-peer.ts).
#
#   weevils sessions                     weevils read <id> [n]        weevils send <id> "message"
#   weevils recall <id>                  rouvre mot pour mot une ligne du journal de weevboss (message, groupe g…, jour d…)
#   weevils boss                         comment tourne weevboss et la taille de ce qu'il lit à chaque message
#   weevils resume <id>                  relance une session coupée en plein travail (état « interrupted »)
#   weevils new <projet> "message" [codex]   weevils projects
#   weevils setup [install | ask <brique> | mark <id>]      weevils config set <CLÉ> <valeur>
#   weevils memory [add "souvenir" | rm <id>]   (ce que weevils retient de l'utilisateur, ~/.config/weevils/memory.json)
#   weevils post "texte" [--action "libellé::quoi faire"]…   un mot dans « pour toi », avec des boutons si besoin
#   weevils show <fichier> ["légende"]                       une image ou une vidéo dans « pour toi »
#   weevils page <dossier|fichier> "titre" --kind <type>      une petite page privée, son lien vivant (docs/LINKS.md)
#     weevils page list <items.json> "titre" [--kind …] · page library "titre" <dossier>… · pages · page rm <slug>
#     post et show, quand ils rapportent un résultat : --demonstrated "où ça a tourné" · --verified "environnement vérifié"
#     · --limit "ce qui n'a pas été vérifié" (répétable). Sans rien : « codé » au plus, quoi que dise le texte.
#   weevils asks [open|all|stale|done]   le registre des demandes de weevboss (server/boss-ledger.ts)
#   weevils ask done|drop|open <id> ["note"] · ask add "demande" [--goal <id>] · ask link <id> <session> ["retour attendu"] · ask goal <id> <objectif>
#   weevils goals [all] · goal add <id> "titre" ["pourquoi"] · goal note <id> "avancée" · goal done|pause|open <id>
#   weevils trace [<objectif>] [n] · trace add "décision" [--goal <id>]   le journal de travail
#   weevils mem [search <mots> | add [rule|decision|fact] "texte" | rm <id>]   la mémoire interne (décisions, règles, faits)
set -euo pipefail
base="http://127.0.0.1:${WEEVILS_PORT:-4179}"
local_token=$HOME/.local/share/weevils/local-token
if [ -r "$local_token" ]; then
  # The header is read from the file (-H @file): the token never shows in the process list.
  curl() { command curl -H "@$local_token" "$@"; }
elif [ -n "$(ls -A "$HOME/.local/share/weevils" 2>/dev/null)" ]; then
  # A real install without its token (weevilsd creates it at start): say so plainly rather than fail without a word.
  if [ "$(sed -n 's/.*"lang" *: *"\([a-z]*\)".*/\1/p' ~/.local/share/weevils/prefs.json 2>/dev/null)" = fr ]; then
    echo "weevils : pas de jeton local ($local_token) : weevilsd refusera. Relance-le : weevils-service restart" >&2 # i18n-ignore
  else echo "weevils: no local token ($local_token): weevilsd will refuse this. Restart it: weevils-service restart" >&2; fi
fi
from=${WEEVILS_FROM:-weevils}
# A project agent is not weevboss. Session sends/new resolve an available source thread on the local server.
sender_from=${WEEVILS_FROM:-agent}
source_thread=${CODEX_THREAD_ID:-${CODEX_SESSION_ID:-${CLAUDE_SESSION_ID:-}}}
if [ -n "$source_thread" ]; then sender_from=agent; fi
py=python3

# Langue des messages : celle de l'app (prefs.json de weevilsd), sinon WEEVILS_LANG (env ou ~/.config/weevils/env),
# LC_ALL, LANG ; anglais par défaut. Même ordre que weevilsd (server/i18n.ts).
wv_lang() {
  local c cfg=${WEEVILS_CONFIG:-$HOME/.config/weevils/env}
  for c in "$(sed -n 's/.*"lang" *: *"\([a-z]*\)".*/\1/p' ~/.local/share/weevils/prefs.json 2>/dev/null)" \
    "${WEEVILS_LANG:-$(sed -n 's/^[[:space:]]*WEEVILS_LANG[[:space:]]*=[[:space:]]*["'\'']\{0,1\}\([A-Za-z_.-]*\).*/\1/p' "$cfg" 2>/dev/null | tail -1)}" \
    "${LC_ALL:-}" "${LANG:-}"; do
    case "$c" in fr|fr[-_.]*|FR*) echo fr; return ;; en|en[-_.]*|EN*) echo en; return ;; esac
  done
  echo en
}
if [ "$(wv_lang)" = fr ]; then
  # i18n-ignore : messages français, l'anglais est juste en dessous (même chose dans la branche else)
  usage='weevils sessions                     weevils read <id> [n]        weevils send <id> "message"
weevils resume <id>                  weevils new <projet> "message" [codex]   weevils projects
weevils recall <id>                  weevils boss
