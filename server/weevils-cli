weevils page list <items.json> "titre" [--kind opportunities] · weevils page library "titre" <dossier>…
weevils pages · weevils page machine · weevils page rm <slug>' # i18n-ignore
  export WVM_NO_ASKS='(aucune demande)' WVM_STALE='EN PANNE' WVM_PENDING='message(s) pas encore découpé(s) en demandes' WVM_REPORT='retour' WVM_EXPECT='attendu' # i18n-ignore
  export WVM_NO_GOALS='(aucun objectif)' WVM_DONE_OF='faites' WVM_NO_TRACE='(journal vide)' WVM_NO_MEM='(rien en mémoire interne)' WVM_DIGEST='tokens par tour' # i18n-ignore
