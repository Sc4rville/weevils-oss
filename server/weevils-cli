# An empty input (the request before it failed and said why on stderr) ends quietly with an error.
json() { local code=$1; shift; "$py" -c "import json,sys,os; E=os.environ; raw=sys.stdin.read(); raw.strip() or sys.exit(1); d=json.loads(raw); $code" "$@"; }

resolve() {
  # Id complet à partir d'un préfixe (8 caractères suffisent).
  curl -sf -m 8 "$base/api/snapshot" | "$py" -c "
import json,sys,os
E=os.environ
want=sys.argv[1]; d=json.load(sys.stdin)
hits=[s['id'] for s in d['sessions'] if s['id'].startswith(want)]
if len(hits)==1: print(hits[0])
elif not hits: print(E['WVM_NOT_FOUND']+want, file=sys.stderr); sys.exit(1)
else: print(E['WVM_AMBIGUOUS'].format(want, ', '.join(h[:12] for h in hits)), file=sys.stderr); sys.exit(1)
" "$1"
}

# POST /api/foryou/<what> with a JSON body; prints <done>, or the server's reason (else the code) on one line.
for_you() {
  local out code body
  out=$(printf '%s' "$3" | curl -s -m 30 -w '\n%{http_code}' -H 'content-type: application/json' --data-binary @- "$base/api/foryou/$1") || true
  code=${out##*$'\n'} body=${out%$'\n'*}
  [ "$code" = 200 ] && { echo "$2"; return 0; }
  printf '%s' "$body" | json "print(d.get('error') or '')" 2>/dev/null | grep . >&2 || echo "$WVM_ERROR $code" >&2
  exit 1
}

# The request ledger (server/boss-ledger-http.ts): GET or POST a JSON body; prints the body, or the reason on stderr.
ledger() {
  local method=$1 url=$2 body=${3-} out code
  if [ "$method" = GET ]; then out=$(curl -s -m 30 -w '\n%{http_code}' "$base$url") || true
  else out=$(printf '%s' "$body" | curl -s -m 600 -X "$method" -w '\n%{http_code}' -H 'content-type: application/json' --data-binary @- "$base$url") || true; fi
  code=${out##*$'\n'} body=${out%$'\n'*}
  [ "$code" = 200 ] && { printf '%s' "$body"; return 0; }
  printf '%s' "$body" | json "print(d.get('error') or '')" 2>/dev/null | grep . >&2 || echo "$WVM_ERROR $code" >&2
  exit 1
}
q() { "$py" -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1],safe=""))' "$1"; }
# Shared by asks/ask: one request on two lines (id, where it is, goal, age; then the text, the exact words, the report).
ASK_FMT='
import time
def age(ms):
    s=ms/1000
    return "%dd" % (s//86400) if s>=86400 else "%dh" % (s//3600) if s>=3600 else "%dm" % max(1,s//60)
def show(a):
    d=(a.get("dispatches") or [])[-1:]
    where=a["status"]
    if d:
        where=("→ " if where=="dispatched" else where+" → ")+d[0]["session"][:8]+(" "+d[0]["label"] if d[0].get("label") else "")
    tags=[where]+([a["goal"]] if a.get("goal") else [])+[age(time.time()*1000-a["at"])]+([E["WVM_STALE"]] if a.get("stale") else [])
    print(a["id"]+"  ["+" · ".join(tags)+"] "+a["text"])
    extra="  “"+a["quote"][:220]+"”"
    if a.get("note"): extra+=" · "+E["WVM_REPORT"]+": "+a["note"][:200]
    elif d and d[0].get("expect"): extra+=" · "+E["WVM_EXPECT"]+": "+d[0]["expect"][:160]
    print("      "+extra)
'
# The evidence supplied with a result (shared/evidence.ts): these flags only, never guessed from the words.
ev_demo='' ev_ver='' ev_limits=()
evidence_flag() {
  [ -n "${2//[[:space:]]/}" ] || { echo "$m_evidence_bad" >&2; exit 1; }
  case "$1" in
    --demonstrated) ev_demo=$2 ;;
    --verified) ev_ver=$2 ;;
    --limit) ev_limits+=("$2") ;;
  esac
}
evidence_json() {
  "$py" -c 'import json,sys
d,v,l=sys.argv[1],sys.argv[2],sys.argv[3:]
e={k:x for k,x in (("demonstrated",d),("verified",v),("limits",l)) if x}
print(json.dumps(e) if e else "null")' "$ev_demo" "$ev_ver" ${ev_limits[@]+"${ev_limits[@]}"}
}

# An automation's run (server/optimizers.ts guardEnv sets WEEVILS_SCOPE=automation): only its permission profile's
# subcommands (AUTO_WEEVILS there); the rest (the ledger's writes, memory, setup, config, resume…) is refused here too.
if [ "${WEEVILS_SCOPE:-}" = automation ]; then
  case "${1:-}" in
    sessions|read|asks|projects|new|send|post|show|page|pages) ;;
    *) echo "weevils ${1:-}: not allowed in an automation run (allowed: sessions, read, asks, projects, new, send, post, show, page, pages)" >&2; exit 3 ;; # i18n-ignore : technical refusal read by an agent
  esac
fi

case "${1:-}" in
  asks)
    filter=${2:-open}
    ledger GET "/api/boss/asks?filter=$(q "$filter")" | json "$ASK_FMT
asks=d.get('asks') or []
if not asks: print(E['WVM_NO_ASKS'])
for a in asks: show(a)
if d.get('pending'): print(f\"({d['pending']} {E['WVM_PENDING']})\")
" ;;
  ask)
    verb=${2:-}
    case "$verb" in
      done|drop|open)
        id=${3:?$m_ask_usage}
        ledger POST "/api/boss/asks/$(q "$id")" "$("$py" -c 'import json,sys; print(json.dumps({"action":sys.argv[1],"note":sys.argv[2]}))' "$verb" "${4-}")" | json "$ASK_FMT
show(d['ask'])" ;;
      add)
        shift 2; text='' goal=''
        while [ $# -gt 0 ]; do case "$1" in --goal) goal=${2-}; shift; [ $# -gt 0 ] && shift ;; *) [ -n "$text" ] || text=$1; shift ;; esac; done
        [ -n "${text//[[:space:]]/}" ] || { echo "$m_ask_usage" >&2; exit 1; }
        ledger POST /api/boss/asks "$("$py" -c 'import json,sys; print(json.dumps({"text":sys.argv[1],"goal":sys.argv[2]}))' "$text" "$goal")" | json "$ASK_FMT
show(d['ask'])" ;;
      link)
        id=${3:?$m_ask_usage} sid=${4:?$m_ask_usage}
        ledger POST "/api/boss/asks/$(q "$id")" "$("$py" -c 'import json,sys; print(json.dumps({"action":"link","session":sys.argv[1],"expect":sys.argv[2]}))' "$sid" "${5-}")" | json "$ASK_FMT
show(d['ask'])" ;;
      goal)
        id=${3:?$m_ask_usage} g=${4:?$m_ask_usage}
        ledger POST "/api/boss/asks/$(q "$id")" "$("$py" -c 'import json,sys; print(json.dumps({"action":"goal","goal":sys.argv[1]}))' "$g")" | json "$ASK_FMT
show(d['ask'])" ;;
      *) echo "$m_ask_usage" >&2; exit 1 ;;
    esac ;;
  goals)
    all=''; [ "${2:-}" = all ] && all='?all=1'
    ledger GET "/api/boss/goals$all" | json "
gs=d.get('goals') or []
if not gs: print(E['WVM_NO_GOALS'])
for g in gs:
    st='' if g['status']=='active' else f\" ({g['status']})\"
    stale=f\", {g['stale']} {E['WVM_STALE']}\" if g.get('stale') else ''
    print(f\"{g['id']}{st}  {g['title']} · {g['done']}/{g['total']} {E['WVM_DONE_OF']}{stale} · {len(g.get('sessions') or [])} sessions\")
    if g.get('progress'): print('      '+g['progress'])
" ;;
  goal)
    verb=${2:-}
    case "$verb" in
      add)
        id=${3:?$m_goal_usage} title=${4:?$m_goal_usage}
        ledger POST /api/boss/goals "$("$py" -c 'import json,sys; print(json.dumps({"id":sys.argv[1],"title":sys.argv[2],"why":sys.argv[3]}))' "$id" "$title" "${5-}")" | json "g=d['goal']; print(g['id']+'  '+g['title'])" ;;
      note)
        id=${3:?$m_goal_usage} text=${4:?$m_goal_usage}
        ledger POST "/api/boss/goals/$(q "$id")" "$("$py" -c 'import json,sys; print(json.dumps({"action":"note","text":sys.argv[1]}))' "$text")" | json "g=d['goal']; print(g['id']+'  '+(g.get('progress') or ''))" ;;
      done|pause|open)
        id=${3:?$m_goal_usage}
        ledger POST "/api/boss/goals/$(q "$id")" "$("$py" -c 'import json,sys; print(json.dumps({"action":sys.argv[1]}))' "$verb")" | json "g=d['goal']; print(g['id']+'  '+g['status'])" ;;
      *) echo "$m_goal_usage" >&2; exit 1 ;;
    esac ;;
  trace)
    if [ "${2:-}" = add ]; then
      shift 2; text='' goal=''
      while [ $# -gt 0 ]; do case "$1" in --goal) goal=${2-}; shift; [ $# -gt 0 ] && shift ;; *) [ -n "$text" ] || text=$1; shift ;; esac; done
      [ -n "${text//[[:space:]]/}" ] || { echo "$usage" >&2; exit 1; }
      ledger POST /api/boss/trace "$("$py" -c 'import json,sys; print(json.dumps({"text":sys.argv[1],"goal":sys.argv[2]}))' "$text" "$goal")" >/dev/null && echo "$WVM_OK"
    else
      goal='' n=30
      for a in "${@:2}"; do case "$a" in *[!0-9]*) goal=$a ;; ?*) n=$a ;; esac; done
      ledger GET "/api/boss/trace?n=$n&goal=$(q "$goal")" | json "
import time
tr=d.get('trace') or []
if not tr: print(E['WVM_NO_TRACE'])
for e in tr:
    when=time.strftime('%m-%d %H:%M', time.localtime(e['at']/1000))
    extra=''.join(f' · {k}: {e[k]}' for k in ('why','expect') if e.get(k))
    who=f\" · {e['who']}\" if e.get('who') and e['kind'] in ('dispatch','report') else ''
    ids=f\" ({', '.join(e['asks'])})\" if e.get('asks') else ''
    st=(' '+e['status']) if e.get('status') else ''
    print(f\"{when} {e['kind']+st:<14} {('['+e['goal']+'] ') if e.get('goal') else ''}{e['text']}{ids}{who}{extra}\")
"
    fi ;;
  mem)
    case "${2:-}" in
      ''|list)
